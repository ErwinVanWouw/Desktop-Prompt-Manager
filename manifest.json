{
  "manifest_version": 3,
  "name": "Prompt Manager for Translators",
  "version": "1.1.8",
  "description": "Easily save, manage, and insert up to 9 custom prompts into supported AI tools using shortcuts.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
      "https://chatgpt.com/*",
      "https://nano-gpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://deepseek.com/*",
	  "https://chat.deepseek.com/*",
      "https://www.phind.com/*",
      "https://www.perplexity.ai/*",
      "https://www.meta.ai/*",
	  "https://mistral.ai/*",
	  "https://chat.mistral.ai/*",
	  "https://deepai.org/*",
	  "https://qwen.ai/*",
	  "https://chat.qwen.ai/*",
	  "https://chatgate.ai/*",
	  "https://publicai.co/*",
	  "https://copilot.microsoft.com/*",
	  "https://ppq.ai/*",
	  "https://laratranslate.com/*",
	  "https://www.google.com/*",
	  "https://www.kimi.com/*",
	  "https://chat.z.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
      "https://chatgpt.com/*",
      "https://nano-gpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://deepseek.com/*",
	  "https://chat.deepseek.com/*",
      "https://www.phind.com/*",
      "https://www.perplexity.ai/*",
      "https://www.meta.ai/*",
	  "https://mistral.ai/*",
	  "https://chat.mistral.ai/*",
	  "https://deepai.org/*",
	  "https://qwen.ai/*",
	  "https://chat.qwen.ai/*",
	  "https://chatgate.ai/*",
	  "https://publicai.co/*",
	  "https://copilot.microsoft.com/*",
	  "https://ppq.ai/*",
	  "https://laratranslate.com/*",
	  "https://www.google.com/*",
	  "https://www.kimi.com/*",
	  "https://chat.z.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
	"commands": {
		"prompt1": {
		  "suggested_key": {
			"default": "Ctrl+Shift+1",
			"mac": "Command+Shift+1"
		  },
		  "description": "Send prompt 1"
		},
		"prompt2": {
		  "suggested_key": {
			"default": "Ctrl+Shift+2",
			"mac": "Command+Shift+2"
		  },
		  "description": "Send prompt 2"
		},
		"prompt3": {
		  "suggested_key": {
			"default": "Ctrl+Shift+3",
			"mac": "Command+Shift+3"
		  },
		  "description": "Send prompt 3"
		},
		"prompt4": {
		  "suggested_key": {
			"default": "Ctrl+Shift+4",
			"mac": "Command+Shift+4"
		  },
		  "description": "Send prompt 4"
		},
		"prompt5": {
		  "description": "Send prompt 5"
		},
		"prompt6": {
		  "description": "Send prompt 6"
		},
		"prompt7": {
		  "description": "Send prompt 7"
		},
		"prompt8": {
		  "description": "Send prompt 8"
		},
		"prompt9": {
		  "description": "Send prompt 9"
		}
  },
  "options_page": "options.html"
}
